# 忽略视频文件
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv

# 忽略图片文件
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.webp
*.ico

# 忽略特定目录下的所有文件
static/uploads/
static/@results/
static/temp/
/tmp/

# 排除特定的保留文件
!static/@results/default_result.jpg
!static/default_result.jpg

# 忽略临时文件
*.tmp
*.temp
*.log
__pycache__/
*.py[cod]
*$py.class

# 忽略数据库文件
*.db
*.sqlite
*.sqlite3

#忽略md文件
*.md

# 忽略会话文件
/sessions/ 