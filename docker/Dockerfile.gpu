# 使用Python 3.9作为基础镜像
FROM python:3.9-slim

# 设置工作目录
WORKDIR /app

# 接收构建参数
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib_config \
    YOLO_CONFIG_DIR=/tmp/ultralytics_config \
    NVIDIA_VISIBLE_DEVICES=all \
    PIP_INDEX_URL=$PIP_INDEX_URL \
    APT_MIRROR=$APT_MIRROR

# 配置apt源
RUN if [ -n "$APT_MIRROR" ]; then \
    sed -i "s/deb.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list && \
    sed -i "s/security.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list; \
    fi

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    default-mysql-client \
    wget \
    curl \
    git \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# 创建必要的目录
RUN mkdir -p /app/static/uploads /app/static/@results /app/static/temp \
    /tmp/matplotlib_config /tmp/ultralytics_config /app/logs /app/sessions

# 复制requirements.txt但排除torch相关依赖（我们将单独安装）
COPY requirements.txt /app/requirements.txt
RUN grep -v "torch\|torchvision\|torchaudio" /app/requirements.txt > /app/requirements_notorch.txt

# 安装Python依赖（除了PyTorch）
RUN pip install --no-cache-dir -r requirements_notorch.txt -i $PIP_INDEX_URL

# 复制PyTorch安装脚本
COPY docker/scripts/install_torch.sh /app/install_torch.sh
RUN chmod +x /app/install_torch.sh

# 执行PyTorch安装脚本
RUN /app/install_torch.sh

# 复制启动脚本并设置权限
COPY docker/scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 复制项目代码
COPY . .

# 设置权限（如果存在这些脚本）
RUN for script in monitor.sh deploy.sh install.sh db_monitor.sh crontab_setup.sh; do \
    if [ -f "/app/$script" ]; then chmod +x /app/$script; fi \
    done

# 暴露端口
EXPOSE 8888

# 设置启动脚本
ENTRYPOINT ["/entrypoint.sh"]

# 启动命令
CMD ["gunicorn", "-c", "gunicorn_config.py", "app:app"]